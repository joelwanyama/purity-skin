# Cache rules for Cloudflare Pages.
# The service worker must never be cached, otherwise updates cannot roll out.
/sw.js
  Cache-Control: no-cache

# Vite fingerprints these filenames, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The owner workspace and the local drafting studio should never appear in search.
/owner
  X-Robots-Tag: noindex, nofollow
/owner/*
  X-Robots-Tag: noindex, nofollow
/studio/*
  X-Robots-Tag: noindex, nofollow

/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
