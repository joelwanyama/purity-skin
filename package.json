{
  "name": "purity-skin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-photo-variants.mjs && node scripts/export-status-cards.mjs && tsc -b && vite build && node scripts/prerender.mjs && node scripts/postbuild.mjs",
    "check:build": "node scripts/check-build.mjs dist",
    "smoke": "node scripts/smoke-deployed.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db && npm run test:e2e && npm run build && npm run check:build && npm audit --audit-level=low",
    "test:db": "node scripts/test-db.mjs",
    "assets": "node scripts/build-brand-assets.mjs",
    "publish:build": "npm run build && npm run check:build && git add -f dist && git commit -m \"Refresh built site output\" || echo \"Nothing to publish: dist is already current.\"",
    "export:whatsapp": "node scripts/export-whatsapp-catalog.mjs",
    "export:cards": "node scripts/export-status-cards.mjs",
    "photos": "node scripts/build-photo-variants.mjs",
    "preview:share": "node scripts/check-share-preview.mjs",
    "guide": "node scripts/build-owner-guide.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
